# Supabase Credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# TCP Server Config
SOCKET_PORT=9001
SOCKET_HOST=0.0.0.0

# Environment and Web Port
NODE_ENV=development
HTTP_PORT=3000

# LBS/Cell Towers Configuration
ALLOWED_MCCS=214
OPENCELLID_API_KEY=your_opencellid_api_key

# Heartbeat & Session Idle Timeout (300000ms = 5 minutes)
SOCKET_IDLE_MS=300000

# TCP Server Mode (false = normal TCP with ACKs and commands, true = read-only listener)
SOCKET_READ_ONLY=false